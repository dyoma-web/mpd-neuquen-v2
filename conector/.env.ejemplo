# Configuración del conector de Justina MPD. Copiar los valores a las variables de entorno del servidor.
# No guardar la clave real en el repositorio.

# --- Visibilidad ---
# 1 muestra el chat en el sitio; 0 lo oculta junto con los botones que lo abren.
CHAT_VISIBLE=1

# --- Conexión con la plataforma de consulta (RAG) ---
# Mientras CHAT_OPERATIVO no sea 1, el conector queda apagado y el chat responde con textos predefinidos.
CHAT_OPERATIVO=0
RAG_URL=
RAG_CLAVE=

# Cómo se envía la clave. Por defecto:  Authorization: Bearer <clave>
RAG_CABECERA=Authorization
RAG_PREFIJO="Bearer "

# Qué espera recibir la plataforma:
#   mensajes  -> { "messages": [ { "role": "user", "content": "..." } ] }
#   pregunta  -> { "question": "...", "history": [ ... ] }
RAG_CUERPO=mensajes
RAG_CAMPO_MENSAJES=messages
RAG_CAMPO_PREGUNTA=question
# Campos fijos que se agregan a cada pedido, en JSON (por ejemplo, el identificador del chatbot).
RAG_CUERPO_EXTRA=

# Cómo responde la plataforma:
#   json    -> una respuesta completa. RAG_CAMPO_RESPUESTA indica dónde está el texto (admite puntos: data.answer).
#   sse     -> fragmentos en líneas «data: {...}». RAG_CAMPO_FRAGMENTO indica dónde viene cada trozo.
#   ndjson  -> un objeto JSON por línea. RAG_CAMPO_FRAGMENTO indica dónde viene cada trozo.
RAG_FORMATO=json
RAG_CAMPO_RESPUESTA=reply
RAG_CAMPO_FRAGMENTO=content
RAG_CAMPO_FUENTES=sources

# --- Servidor ---
PUERTO=8787
# Sitios que pueden usar el conector, separados por coma. Vacío: solo el mismo dominio.
ORIGENES_PERMITIDOS=
ESPERA_MS=55000
LIMITE_POR_MINUTO=20
MAX_MENSAJES=10
MAX_CARACTERES=2000
